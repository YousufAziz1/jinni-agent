# ==============================================================================
# JINNI Agent — Backend Environment Configuration Template
# Tagline: Autonomous actions. Independent judgment.
# Supporting line: AI agents can propose. GenLayer decides.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GenLayer Intelligent Adjudication Network
# ------------------------------------------------------------------------------
# Target network: studionet (hosted Studio), localnet (local simulator), or testnet
GENLAYER_NETWORK=studionet
GENLAYER_CHAIN_ID=61999
GENLAYER_RPC=https://studio.genlayer.com/api
# Deployed JinniAgentGuard contract address on GenLayer Studionet.
JINNI_AGENT_CONTRACT_ADDRESS=0xa54cF1bBCfe4456b6194658699aab540fBeF046c
GENLAYER_EXPLORER_BASE_URL=https://explorer-studio.genlayer.com

# ------------------------------------------------------------------------------
# 2. Off-Chain AI Provider Configuration (Free tier or local Ollama fallback)
# ------------------------------------------------------------------------------
# Provider options:
# - gemini (Free tier via Google AI Studio / OpenAI-compat: https://aistudio.google.com/)
# - groq (Free cloud tier: https://console.groq.com/keys)
# - ollama (100% free local model, 0 keys needed: http://localhost:11434/v1)
# Note: Off-chain AI is strictly a proposal generator; GenLayer independently adjudicates.
AI_PROVIDER=gemini
AI_API_KEY=your_free_gemini_api_key_here
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local Ollama Fallback (Automatic if cloud key is not set or offline)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 3. Ethereum Sepolia Network & Execution Vault
# ------------------------------------------------------------------------------
SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia/your_rpc_key_here
DELEGATOR_CONTRACT_ADDRESS=0x5462D420CEf200c8704Db6b48BE9Db3A000A231C

# Sepolia Token Addresses
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
LINK_ADDRESS=0x779877A7B0D9E8603169DdbD7836e478b4624789
UNI_ADDRESS=0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984

# ------------------------------------------------------------------------------
# 4. Database & Server
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./jinni.db
PORT=8000
