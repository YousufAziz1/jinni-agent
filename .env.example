# Backend configuration is placed inside backend/.env
# GenLayer Intelligent Contract settings:
GENLAYER_NETWORK=studionet
GENLAYER_CHAIN_ID=61999
GENLAYER_RPC=https://studio.genlayer.com/api
JINNI_AGENT_CONTRACT_ADDRESS=0xa54cF1bBCfe4456b6194658699aab540fBeF046c
GENLAYER_EXPLORER_BASE_URL=https://explorer-studio.genlayer.com

# Off-Chain AI Provider (Free tier: Groq, Google Gemini via OpenAI-compat, or local Ollama):
# Note: Off-chain AI strictly generates proposals. GenLayer Intelligent Contract independently adjudicates.
AI_PROVIDER=groq
AI_API_KEY=your_free_groq_or_gemini_api_key_here
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Sepolia Network & Execution Vault:
SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia/your_rpc_key_here
DELEGATOR_CONTRACT_ADDRESS=0x5462D420CEf200c8704Db6b48BE9Db3A000A231C
